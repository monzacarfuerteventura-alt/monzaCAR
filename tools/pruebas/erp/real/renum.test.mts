// Numeración de formularios (act. 72): FORM-01…FORM-17 sin huecos, mismo nombre en PDF, panel y manuales, y los datos antiguos siguen vivos.
// Código REAL de sistemas.mts y manuales.mts con el almacén simulado. Lo ejecuta ejecutar-real.sh
(globalThis as any).Netlify = { env: { get: (k: string) => ({ ADMIN_PASSWORD: "clave-de-prueba", SESSION_SECRET: "s3" } as any)[k] || "" }, context: { deploy: { context: "production" } } };
import { readFileSync, existsSync } from "node:fs"; import { spawnSync } from "node:child_process";
const { crearSesion, store } = await import("./netlify/lib/shared.mts");
const SIS = (await import("./netlify/functions/sistemas.mts")).default, MAN = (await import("./netlify/functions/manuales.mts")).default;
const tok = crearSesion().token; let n = 0, f = 0; const ok = (c: any, m: string) => { n++; if (!c) { f++; console.log("✗ " + m); } else console.log("✓ " + m); };
const call = async (fn: any, m: string, path: string, body?: any) => { const r = await fn(new Request("https://volcanocars.test" + path, { method: m, headers: { authorization: "Bearer " + tok, "content-type": "application/json", origin: "https://volcanocars.test", host: "volcanocars.test" }, body: body ? JSON.stringify(body) : undefined }), {}); const ct = r.headers.get("content-type") || ""; return { s: r.status, ct, b: ct.includes("json") ? await r.json() : Buffer.from(await r.arrayBuffer()) }; };
const CANON: Record<string, string> = { "FORM-01": "Ficha de recepción", "FORM-02": "Inspección de entrada 360°", "FORM-03": "Presupuesto", "FORM-04": "Control de tiempos y mano de obra", "FORM-05": "Control de calidad pre-entrega", "FORM-06": "Factura de reparación", "FORM-07": "Cascos y abonos", "FORM-08": "Ronda 5S y seguridad", "FORM-09": "Hoja de preparación", "FORM-10": "Parte de reserva de vehículo", "FORM-11": "Factura de venta de vehículo", "FORM-12": "Prueba a domicilio · fianza 50 €", "FORM-13": "Registro de postventa", "FORM-14": "Plan semanal de marketing", "FORM-15": "Auditoría del viernes", "FORM-16": "Organigrama y RACI", "FORM-17": "Cuadro de mando" };
const PDFS = ["FORM-01", "FORM-02", "FORM-03", "FORM-04", "FORM-05", "FORM-06", "FORM-10", "FORM-11"], DIGITALES = ["FORM-07", "FORM-08", "FORM-09", "FORM-12", "FORM-13", "FORM-14", "FORM-15"];
// 1) los datos de antes de la 72 siguen donde estaban y se ven con el número nuevo
const s = store("sistemas");
await s.setJSON("FORM-05/20260901100000-aaaaaaaa", { id: "20260901100000-aaaaaaaa", form: "FORM-05", creado: "2026-09-01T10:00:00Z", autor: "Ana", actualizado: "2026-09-01T10:00:00Z", porUltimo: "Ana", cerrado: false, firma: null, datos: { nota: "cascos antiguos" } });
await s.setJSON("FORM-09/20260902100000-bbbbbbbb", { id: "20260902100000-bbbbbbbb", form: "FORM-09", creado: "2026-09-02T10:00:00Z", autor: "Luis", actualizado: "2026-09-02T10:00:00Z", porUltimo: "Luis", cerrado: false, firma: null, datos: { nota: "postventa antigua" } });
let r: any = await call(SIS, "GET", "/api/sistemas?form=FORM-07"); ok(r.s === 200 && r.b.registros.length === 1 && r.b.registros[0].datos.nota === "cascos antiguos" && r.b.registros[0].form === "FORM-07", "el registro antiguo de cascos (FORM-05 de antes) aparece como FORM-07 Cascos y abonos");
r = await call(SIS, "GET", "/api/sistemas?form=FORM-13"); ok(r.s === 200 && r.b.registros.length === 1 && r.b.registros[0].datos.nota === "postventa antigua" && r.b.registros[0].form === "FORM-13", "el de postventa (FORM-09 de antes) aparece como FORM-13 Registro de postventa");
r = await call(SIS, "GET", "/api/sistemas?form=FORM-09"); ok(r.s === 200 && r.b.registros.length === 0, "FORM-09 (Hoja de preparación) NO se mezcla con la postventa antigua que tenía el número 09");
for (const mal of ["FORM-05", "FORM-06", "FORM-10", "FORM-11", "FORM-16", "FORM-17", "FORM-01"]) { r = await call(SIS, "GET", "/api/sistemas?form=" + mal); ok(r.s === 400, mal + " (" + CANON[mal] + ") no es un formulario digital: 400"); }
// 2) escribir con el número nuevo guarda en la clave física de siempre
r = await call(SIS, "POST", "/api/sistemas", { form: "FORM-09", datos: { coche: "Seat Ibiza" } }); ok(r.s === 201 && r.b.form === "FORM-09", "alta en FORM-09 Hoja de preparación (" + r.s + ")"); const id9 = r.b.id;
ok((await s.get("FORM-07/" + id9, { type: "json" })) !== null && (await s.get("FORM-09/" + id9, { type: "json" })) === null, "se guarda en la clave física antigua FORM-07/ (no se crea otra y no se pierde nada)");
r = await call(SIS, "GET", "/api/sistemas?form=FORM-09"); ok(r.b.registros.length === 1 && r.b.registros[0].datos.coche === "Seat Ibiza", "se lee con el número nuevo");
r = await call(SIS, "PUT", "/api/sistemas", { form: "FORM-09", id: id9, datos: { coche: "Seat Ibiza", km: "90000" }, cerrar: true }); ok(r.s === 200 && r.b.cerrado === true && r.b.form === "FORM-09", "firmar y cerrar");
r = await call(SIS, "PUT", "/api/sistemas", { form: "FORM-07", id: "20260901100000-aaaaaaaa", datos: { nota: "editado" } }); ok(r.s === 200 && r.b.datos.nota === "editado" && r.b.form === "FORM-07", "editar el registro antiguo con el número nuevo");
r = await call(SIS, "DELETE", `/api/sistemas?form=FORM-13&id=20260902100000-bbbbbbbb`); ok(r.s === 200 && (await s.get("FORM-09/20260902100000-bbbbbbbb", { type: "json" })) === null, "borrar (gerente) el antiguo de postventa");
// 3) PDF: los que existen y los que no
for (const x of [...PDFS, "FICHAS-TALLER"]) { r = await call(MAN, "GET", "/api/manual/" + x); ok(r.s === 200 && r.ct.includes("pdf") && r.b.slice(0, 4).toString() === "%PDF", "PDF " + x + " se sirve"); }
for (const x of ["FORM-07", "FORM-08", "FORM-09", "FORM-12", "FORM-13", "FORM-14", "FORM-15", "FORM-16", "FORM-17", "FORM-18", "FORM-00"]) { r = await call(MAN, "GET", "/api/manual/" + x); ok(r.s === 404, x + " no tiene PDF: 404"); }
r = await call(MAN, "GET", "/api/manual/VolcanoCars-S00-Hoja-v3.3-Renumeracion-formularios"); ok(r.s === 200 && r.ct.includes("pdf"), "la Hoja v3.3 de equivalencias se sirve");
for (const x of ["S00-Indice-MO-00-v3.0", "S00-Hoja-v3.2-Fe-de-erratas", "S01-Taller-recepcion-a-entrega", "S11-Cuadro-de-mando-metricas"]) { r = await call(MAN, "GET", "/api/manual/VolcanoCars-" + x); ok(r.s === 200, "manual " + x + " sigue sirviéndose"); }
// 4) cada PDF dice lo que debe y sus referencias cruzadas apuntan al formulario correcto
const txt = (p: string) => spawnSync("pdftotext", ["-layout", p, "-"], { encoding: "utf8" }).stdout;
for (const x of PDFS) { const t = txt(`netlify/privado/formularios/${x}.pdf`), cab = t.split("\n").map((l) => l.trim()).filter(Boolean); ok(cab[0].toLowerCase() === CANON[x].replace(/ \(.*/, "").toLowerCase(), x + ": el título del PDF «" + cab[0] + "» = «" + CANON[x] + "»"); ok(cab.includes(x), x + ": lleva su número en la cabecera"); }
ok(/FORM-04/.test(txt("netlify/privado/formularios/FORM-05.pdf")) && /FORM-04/.test(txt("netlify/privado/formularios/FORM-06.pdf")), "el control de calidad y la factura citan FORM-04 (tiempos) donde deben");
ok(/FORM-05/.test(txt("netlify/privado/formularios/FORM-11.pdf")), "la factura de venta cita FORM-05 (control de calidad)");
const ft = txt("netlify/privado/formularios/FICHAS-TALLER.pdf"); ok(["FORM-01", "FORM-02", "FORM-03", "FORM-04", "FORM-05", "FORM-06"].every((x) => ft.includes(x)) && ft.indexOf("FICHA DE RECEPCIÓN") < ft.indexOf("INSPECCIÓN DE ENTRADA") && ft.indexOf("INSPECCIÓN DE ENTRADA") < ft.indexOf("PRESUPUESTO") && ft.indexOf("PRESUPUESTO") < ft.indexOf("CONTROL DE TIEMPOS") && ft.indexOf("CONTROL DE TIEMPOS") < ft.indexOf("CONTROL DE CALIDAD") && ft.indexOf("CONTROL DE CALIDAD") < ft.indexOf("FACTURA DE REPARACIÓN"), "FICHAS-TALLER.pdf las trae en orden 01 a 06");
// 5) Documentación: los 17, consecutivos, con el nombre oficial, y el PDF solo donde existe
const docs = readFileSync("public/panel-docs.js", "utf8"), filas = [...docs.matchAll(/\["(FORM-\d\d)", "([^"]+)", "([^"]+)", "([^"]+)", "([^"]*)"\]/g)].map((m) => ({ n: m[1], t: m[2], man: m[3], pdf: m[5] }));
ok(filas.length === 17 && filas.every((x, i) => x.n === "FORM-" + String(i + 1).padStart(2, "0")), "Documentación lista los 17 formularios, del 01 al 17 sin saltos");
ok(filas.every((x) => x.t.replace(/ \(.*/, "") === CANON[x.n].replace(/ \(.*/, "")), "los nombres de Documentación = los oficiales: " + filas.filter((x) => x.t.replace(/ \(.*/, "") !== CANON[x.n].replace(/ \(.*/, "")).map((x) => x.n + " «" + x.t + "»").join(", "));
ok(filas.filter((x) => x.pdf).map((x) => x.n).join() === PDFS.join() && filas.filter((x) => x.pdf).every((x) => existsSync(`netlify/privado/formularios/${x.pdf}.pdf`)), "tienen botón PDF exactamente los que existen: " + PDFS.join(" "));
const orden = filas.map((x) => x.man.split(" ")[0]); ok(orden.every((m, i) => i === 0 || Number(m.slice(1)) >= Number(orden[i - 1].slice(1))), "el orden de los formularios sigue el de los manuales S01→S11");
// 6) sistemas: los 7 digitales (y solo ellos) tienen clave física antigua distinta e inyectiva
const sis = readFileSync("netlify/functions/sistemas.mts", "utf8"), fis = Object.fromEntries([...sis.match(/const FIS[^\n]+/)![0].matchAll(/"(FORM-\d\d)": "(FORM-\d\d)"/g)].map((m) => [m[1], m[2]])); ok(Object.keys(fis).join() === DIGITALES.join() && new Set(Object.values(fis)).size === 7, "FIS cubre los 7 digitales y no repite claves físicas");
console.log(f ? "HAY FALLOS (" + f + ")" : "OK numeración de formularios: " + n + " comprobaciones"); process.exit(f ? 1 : 0);
